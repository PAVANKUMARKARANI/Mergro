# Copy to server/.env and fill in. server/.env is git-ignored; never commit real values.
NODE_ENV=development
SERVER_PORT=2282
# mongodb://<user>:<url-encoded-password>@<host>:<port>/mergro?authSource=admin
MONGO_HOST=
MONGO_TEST_HOST=
# Random 48+ byte hex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWTSECRET=
ENCRYPTION_KEY=
# SMS OTP providers
SMS_FROM_NUMBER=
SMS_OTP_TEST_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
NEXMO_API_KEY=
NEXMO_API_SECRET=
# SendGrid is read from server/sendgrid.env: SENDGRID_API_KEY=
# Links in emails: the web page that handles /changeRecoverPassword/:enEmail?token=…, and this API
WEB_APP_URL=
API_URL=
# Optional: password for the demo users created by `npm run seed` (default Emp1234$)
SEED_USER_PASSWORD=
